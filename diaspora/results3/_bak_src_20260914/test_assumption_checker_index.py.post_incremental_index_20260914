def _dump(seeds, pcs, calls, scenario="s1", alias=None):
    """The smallest dump `corpus_index` reads every field of."""
    events = [{"type": "path_condition", "expr": e, "taken": t} for e, t in pcs]
    events += [{"type": "symbolic_call", "target": tg, "note": n, "args": {},
                "result_name": f"r{i}"} for i, (tg, n) in enumerate(calls)]
    d = {"events": events, "concolic_seeds": dict(seeds),
         "concolic_scenario": {"name": scenario}}
    if alias:
        d["_alias_map"] = dict(alias)
        d["_alias_key"] = {o: f"stmt::{c}" for o, c in alias.items()}
        d["_alias_len"] = {o: 3 for o in alias}
    return d


def _corpus(tmp_path, n=6):
    """`n` dumps, each with its own outcome profile and seed richness."""
    for i in range(n):
        d = _dump({"a": i, f"k{i}": 1},
                  [("(a > 0)", i % 2 == 0), (f"(b{i % 3} == 1)", True)],
                  [("Post.find", f"SELECT {i % 2}")],
                  scenario="s1" if i % 2 == 0 else "s2",
                  alias={f"o_{i}": f"c_{i % 2}"})
        with open(os.path.join(str(tmp_path), f"dump_{i:03d}.json"), "w") as fh:
            json.dump(d, fh)
    return str(tmp_path)


def _reset():
    AC._INDEX.clear()
    AC._ALIAS_INDEX.clear()
    AC._TRACE_INDEX.clear()
    AC._POSTINGS.clear()
    AC._PSW_CACHE.clear()
    AC._PROFILE_REPS.clear()
    AC._ROUTE_CACHE.clear()
    AC._ROUTE_BASES.clear()
    AC._Z3_DECLS.clear()
    AC._CORPUS_DIGEST.clear()
    AC._SEEDS_BY_PATH.clear()
    AC._DERIVE_CK = None
    AC._DECLARED_DIGEST = ""
    AC._CANON_FN = None
    AC._ALIASES = None
    if hasattr(AC._load_dump_cached, "cache_clear"):
        AC._load_dump_cached.cache_clear()


def _snapshot_of_indices(batch):
    """Everything `corpus_index` builds, in a comparable form."""
    return (AC._INDEX[batch],
            {p: (d, sorted(sh), sorted(pcs))
             for p, (d, sh, pcs) in (AC._TRACE_INDEX.get(batch) or {}).items()},
            AC._ALIAS_INDEX.get(batch) or {})


