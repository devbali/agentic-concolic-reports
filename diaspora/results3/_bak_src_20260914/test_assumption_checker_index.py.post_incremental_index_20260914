def test_index_checkpoint_off_by_default(tmp_path, monkeypatch):
    monkeypatch.delenv(AC.INDEX_CKPT_ENV, raising=False)
    _reset()
    batch = _corpus(tmp_path, 4)
    AC.corpus_index(batch)
    assert not [f for f in os.listdir(batch) if not f.startswith("dump_")]
    print("  PASS: no variable -> nothing written, the index behaves as before")


def test_a_recorded_index_is_replayed_without_reparsing_one_dump(tmp_path, monkeypatch):
    _reset()
    batch = _corpus(tmp_path, 6)
    ck = str(tmp_path / "index.jsonl")
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)

    AC.corpus_index(batch)
    first = _snapshot_of_indices(batch)
    assert os.path.exists(ck)

    n = {"loads": 0}
    real = AC._load_dump_uncached
    monkeypatch.setattr(AC, "_load_dump_uncached",
                        lambda p: (n.__setitem__("loads", n["loads"] + 1), real(p))[1])
    AC._INDEX.clear(); AC._TRACE_INDEX.clear(); AC._ALIAS_INDEX.clear()
    AC.corpus_index(batch)
    assert n["loads"] == 0, "a recorded index must not re-parse a single dump"
    assert _snapshot_of_indices(batch) == first, "the replayed index must be identical"
    print("  PASS: the second run replays the index instead of re-parsing the corpus")


def test_a_kill_mid_index_resumes_at_the_dump_it_died_on(tmp_path, monkeypatch):
    _reset()
    batch = _corpus(tmp_path, 6)
    ck = str(tmp_path / "index.jsonl")
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)

    real = AC._load_dump_uncached
    n = {"loads": 0}

    def dying(p):
        n["loads"] += 1
        if n["loads"] > 3:
            raise KeyboardInterrupt("killed mid-index")
        return real(p)

    monkeypatch.setattr(AC, "_load_dump_uncached", dying)
    try:
        AC.corpus_index(batch)
    except KeyboardInterrupt:
        pass
    AC._INDEX.clear(); AC._TRACE_INDEX.clear(); AC._ALIAS_INDEX.clear()

    n["loads"] = 0
    monkeypatch.setattr(AC, "_load_dump_uncached",
                        lambda p: (n.__setitem__("loads", n["loads"] + 1), real(p))[1])
    AC.corpus_index(batch)
    assert n["loads"] == 3, f"only the un-recorded dumps must be parsed, got {n['loads']}"
    assert len(AC._INDEX[batch]) == 6
    print("  PASS: a killed index resumes at the dump it died on")


# --------------------------------------------------------------------------
# the index checkpoint is INCREMENTAL (2026-09-14)
#
# It used to be keyed WHOLE on a digest of the corpus, so any drive round --
# which is to say every round -- moved the key and rebuilt 130k-232k rows from
# zero: notifications' C22 declined to run its engine section rather than
# spend 2 h 20 m re-indexing for 422 new dumps. A row is computed from ONE
# dump and recorded per dump, so membership is now settled per row and only
# the IDENTITY of the computation invalidates the lot.
# --------------------------------------------------------------------------

def _counted_loads(monkeypatch):
    """[loads] — the number of dumps actually parsed from here on."""
    n = {"loads": 0}
    real = AC._load_dump_uncached
    monkeypatch.setattr(AC, "_load_dump_uncached",
                        lambda p: (n.__setitem__("loads", n["loads"] + 1), real(p))[1])
    return n


def _fingerprint(batch):
    """A BYTE fingerprint of everything `corpus_index` builds. Two indices
    with the same fingerprint are the same index, not an equivalent one."""
    idx, trace, alias = _snapshot_of_indices(batch)
    return json.dumps([[[p, sorted(s.items()), sc, sorted(e)] for p, s, sc, e in idx],
                       sorted(trace.items()), sorted(alias.items())],
                      sort_keys=True, default=str)


def _rebuild_from_scratch(batch, monkeypatch, tmp_path, tag):
    """The fingerprint of an index built with no checkpoint at all."""
    _reset()
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, str(tmp_path / f"scratch-{tag}.jsonl"))
    AC.corpus_index(batch)
    return _fingerprint(batch)


def _add_dump(batch, i):
    with open(os.path.join(batch, f"dump_{i:03d}.json"), "w") as fh:
        json.dump(_dump({"a": i, f"k{i}": 1}, [("(a > 0)", i % 2 == 0),
                                               (f"(b{i % 3} == 1)", True)],
                        [("Post.find", f"SELECT {i % 2}")],
                        scenario="s1" if i % 2 == 0 else "s2",
                        alias={f"o_{i}": f"c_{i % 2}"}), fh)


def test_a_grown_corpus_indexes_only_the_new_dumps(tmp_path, monkeypatch):
    """(b) N new dumps cost N dumps, and the result is the from-scratch one."""
    _reset()
    batch = _corpus(tmp_path, 4)
    ck = str(tmp_path / "index.jsonl")
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    AC.corpus_index(batch)

    for i in (9, 10, 11):                              # the corpus grew by 3
        _add_dump(batch, i)
    _reset()
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    n = _counted_loads(monkeypatch)
    AC.corpus_index(batch)
    assert n["loads"] == 3, f"only the new dumps may be parsed, got {n['loads']}"
    assert not os.path.exists(ck + ".stale"), "a grown corpus must not be discarded"
    grown = _fingerprint(batch)
    assert grown == _rebuild_from_scratch(batch, monkeypatch, tmp_path, "grown")
    print("  PASS: a corpus that grew by N costs N dumps and the same index")


def test_a_shrunk_corpus_drops_the_rows_and_compacts_the_log(tmp_path, monkeypatch):
    """(c) rows for vanished dumps leave the index AND the log."""
    _reset()
    batch = _corpus(tmp_path, 6)
    ck = str(tmp_path / "index.jsonl")
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    AC.corpus_index(batch)
    assert _records_in(ck) == 6

    for i in (1, 4):
        os.unlink(os.path.join(batch, f"dump_{i:03d}.json"))
    _reset()
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    n = _counted_loads(monkeypatch)
    AC.corpus_index(batch)
    assert n["loads"] == 0, "the survivors must still be replayed"
    assert len(AC._INDEX[batch]) == 4
    shrunk = _fingerprint(batch)
    assert _records_in(ck) == 4, "the log must not carry a gone dump's row"
    assert shrunk == _rebuild_from_scratch(batch, monkeypatch, tmp_path, "shrunk")

    # and the compacted log is still readable: the string table survived it
    _reset()
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    n = _counted_loads(monkeypatch)
    AC.corpus_index(batch)
    assert n["loads"] == 0, "a compacted log must still replay every row"
    assert _fingerprint(batch) == shrunk
    print("  PASS: vanished dumps lose their rows, and the compacted log replays")


def test_a_dump_rewritten_under_the_same_name_is_reindexed(tmp_path, monkeypatch):
    """The per-row stamp is the whole of the corpus membership check, so it
    has to catch a same-name replacement -- including a same-SIZE one, which
    is why the stamp carries mtime as well as size."""
    _reset()
    batch = _corpus(tmp_path, 4)
    ck = str(tmp_path / "index.jsonl")
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    AC.corpus_index(batch)

    victim = os.path.join(batch, "dump_002.json")
    before = os.path.getsize(victim)
    d = json.load(open(victim))
    d["events"][0]["expr"] = "(a < 0)"          # SAME LENGTH, different decision
    with open(victim, "w") as fh:
        json.dump(d, fh)
    os.utime(victim, ns=(os.stat(victim).st_mtime_ns + 10 ** 9,) * 2)
    assert os.path.getsize(victim) == before, "the point of the test: size alone is blind"

    _reset()
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    n = _counted_loads(monkeypatch)
    AC.corpus_index(batch)
    assert n["loads"] == 1, f"only the rewritten dump may be re-parsed, got {n['loads']}"
    assert _records_in(ck) == 4, "the superseded record must not survive compaction"
    assert _fingerprint(batch) == _rebuild_from_scratch(batch, monkeypatch,
                                                        tmp_path, "rewritten")
    print("  PASS: a dump rewritten under its own name is re-indexed, not replayed")


def test_a_changed_engine_source_rebuilds_everything(tmp_path, monkeypatch):
    """(d) the IDENTITY part is still all-or-nothing, exactly as before: it
    says how a row is COMPUTED, so every row it wrote is wrong."""
    _reset()
    batch = _corpus(tmp_path, 4)
    ck = str(tmp_path / "index.jsonl")
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    AC.corpus_index(batch)

    _reset()
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    monkeypatch.setattr(AC._ckpt, "source_hash", lambda *m: "a-different-engine")
    n = _counted_loads(monkeypatch)
    AC.corpus_index(batch)
    assert n["loads"] == 4, "a changed engine source must re-index the corpus"
    assert os.path.exists(ck + ".stale"), "and rotate the old log aside"
    print("  PASS: a changed engine source is still a full rebuild")


def test_the_declared_set_is_not_part_of_the_index_key(tmp_path, monkeypatch):
    """The load-bearing claim of the key split: a declaration reaches an index
    row ONLY through `_ALIASES`, which `_canon_key` digests exactly. So a
    materially different declared set replays every row and produces a
    BYTE-IDENTICAL index -- which is what lets one round's index serve the
    next, and the next round is where the saving actually lands."""
    _reset()
    batch = _corpus(tmp_path, 5)
    ck = str(tmp_path / "index.jsonl")
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    AC._DECLARED_DIGEST = AC._ckpt.digest(
        [{"type": "IndependenceAssumption", "expr_a": "(a > 0)", "expr_b": "(b0 == 1)"}])
    AC.corpus_index(batch)
    under_a = _fingerprint(batch)

    AC._INDEX.clear(); AC._TRACE_INDEX.clear(); AC._ALIAS_INDEX.clear()
    AC._DECLARED_DIGEST = AC._ckpt.digest(
        [{"type": "ConfinementAssumption", "expr": "(b1 == 1)", "footprint": ["x"]},
         {"type": "ConjunctionForeclosureAssumption", "expr": "(a > 0)",
          "prefix": [["(b2 == 1)", True]], "inferred": True},
         {"type": "UntrackedPathAssumption", "expr": "(zzz == 9)"}])
    n = _counted_loads(monkeypatch)
    AC.corpus_index(batch)
    assert n["loads"] == 0, "a declared set that cannot change a row must not rebuild"
    assert _fingerprint(batch) == under_a, "and the index must be byte-identical"
    print("  PASS: the declared set alone neither invalidates nor changes the index")


def test_an_alias_declaration_does_move_the_index_key(tmp_path, monkeypatch):
    """The negative control for the test above. An ALIAS declaration changes
    how every dump is canonicalized at load, so it must invalidate — and it
    is `_canon_key`, not the declared digest, that says so."""
    from concolic_engine.assumptions import AliasAssumption

    def fake_canon(d, aliases=None):
        k = (aliases or [{}])[0]
        return {ev["result_name"]: f"c_{getattr(k, 'k', 1)}::{ev.get('note')}"
                for ev in d.get("events") or []
                if ev.get("type") == "symbolic_call" and ev.get("result_name")}

    _reset()
    batch = _corpus(tmp_path, 4)
    ck = str(tmp_path / "index.jsonl")
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    AC._CANON_FN = fake_canon
    AC._ALIASES = [AliasAssumption(result_pattern="r.*", key="statement", k=1)]
    AC.corpus_index(batch)
    under_k1 = _fingerprint(batch)

    _reset()
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    AC._CANON_FN = fake_canon
    AC._ALIASES = [AliasAssumption(result_pattern="r.*", key="loop", k=2)]
    n = _counted_loads(monkeypatch)
    AC.corpus_index(batch)
    assert n["loads"] == 4, "a different alias must re-index the corpus"
    assert os.path.exists(ck + ".stale")
    assert _fingerprint(batch) != under_k1, "and it really does change the rows"
    _reset()
    print("  PASS: an alias declaration moves the key, and the index with it")


def test_only_one_process_writes_an_index_log(tmp_path, monkeypatch):
    """The log's string table numbers strings by their POSITION in the file,
    so two writers would each number from their own view of it and every
    later reader would decode the wrong string for half the rows — silently.
    A second writer therefore indexes WITHOUT the checkpoint (correct, merely
    uncached) instead of interleaving into it."""
    import fcntl

    _reset()
    batch = _corpus(tmp_path, 4)
    ck = str(tmp_path / "index.jsonl")
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    AC.corpus_index(batch)
    first = _fingerprint(batch)

    held = open(ck + ".lock", "a+")            # stand in for the other gate
    fcntl.flock(held.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    _reset()
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    n = _counted_loads(monkeypatch)
    out = []
    monkeypatch.setattr("builtins.print", lambda *a, **k: out.append(" ".join(map(str, a))))
    AC.corpus_index(batch)
    monkeypatch.undo()
    assert n["loads"] == 4, "a second writer must index, not replay"
    assert any("another process is writing" in line for line in out), out
    assert _records_in(ck) == 4, "and must not append to the other's log"
    assert _fingerprint(batch) == first, "and must still build the same index"
    held.close()

    # with the lock released the next run resumes as usual
    _reset()
    monkeypatch.setenv(AC.INDEX_CKPT_ENV, ck)
    n = _counted_loads(monkeypatch)
    AC.corpus_index(batch)
    assert n["loads"] == 0 and _fingerprint(batch) == first
    print("  PASS: one writer at a time; the loser indexes without the checkpoint")


def _records_in(path):
    """Records (not the header) in a checkpoint log."""
    with open(path) as fh:
        return sum(1 for i, line in enumerate(fh) if i and line.strip())


def test_run_declared_sets_the_declared_digest(tmp_path, monkeypatch):
    _reset()
    batch = _corpus(tmp_path, 2)
    monkeypatch.setattr(AC, "run_probe", lambda *a, **k: {})
    AC.run_declared({"batch_dir": batch, "runner": "/bin/true"},
                    [{"type": "UntrackedPathAssumption", "expr": "(a > 0)"}])
    assert AC._DECLARED_DIGEST and AC._DECLARED_DIGEST != ""
    print("  PASS: run_declared keys the index checkpoint on the declared set")


def test_row_codec_round_trip_is_exact_across_records():
    """The string table only means anything when the records are replayed in
    file order; a row must come back byte-identical either way."""
    enc, dec = AC._RowCodec(), AC._RowCodec()
    rows = [{"s": {"k1": 1, "k2": "x"}, "n": "s1",
             "p": [["(a > 0)", True], ["(b == 1)", False]],
             "h": ["T | SELECT 1 | ", "T | SELECT 2 | "],
             "a": [["o_1", "c_1", "stmt::c_1", 3]]},
            {"s": {"k1": 2}, "n": None, "p": [["(a > 0)", False]],
             "h": ["T | SELECT 1 | "]}]
    recs = [enc.encode(r) for r in rows]
    for rec in recs:                    # the file-order table pass
        dec.register(rec)
    assert [dec.decode(r) for r in recs] == rows
    assert recs[1]["+"] == [], "a repeated string must not be emitted twice"
    print("  PASS: the interned index row round-trips exactly")


def test_checkpoint_items_are_in_file_order_and_pop_forgets(tmp_path):
    from concolic_engine import checkpoint as CK
    p = str(tmp_path / "c.jsonl")
    c = CK.Checkpoint(p, {"k": "v"}, install_signal_handlers=False)
    for i in range(4):
        c.put(f"k{i}", {"i": i})
    c.close()
    c2 = CK.Checkpoint(p, {"k": "v"}, install_signal_handlers=False)
    assert [k for k, _v in c2.items()] == ["k0", "k1", "k2", "k3"]
    assert c2.pop("k1") == {"i": 1}
    assert "k1" not in c2 and c2.pop("k1") is None
    assert [k for k, _v in c2.items()] == ["k0", "k2", "k3"]
    c2.close()
    # forgetting is not un-recording: the log still carries the record
    c3 = CK.Checkpoint(p, {"k": "v"}, install_signal_handlers=False)
    assert "k1" in c3
    c3.close()
    print("  PASS: items() is file-ordered, pop() forgets in memory only")


# --------------------------------------------------------------------------
# the memos: same answers, invalidated on a rebuild
# --------------------------------------------------------------------------

def test_pick_snapshot_with_memo_agrees_with_a_full_scan(tmp_path):
    _reset()
    batch = _corpus(tmp_path, 8)
    rows = AC.corpus_index(batch)

    def full_scan(exprs):
        best = None
        exprs = [AC.canon(e) for e in exprs]
        for p, seeds, _s, rec in rows:
            if not all(e in rec for e in exprs):
                continue
            if best is None or len(seeds) > len(best[1]):
                best = (p, seeds)
        return best[0] if best else None

    for exprs in ([], ["(a > 0)"], ["(b0 == 1)"], ["(a > 0)", "(b1 == 1)"],
                  ["(nowhere == 1)"], ["(a > 0)", "(nowhere == 1)"]):
        got = AC.pick_snapshot_with(batch, exprs, [])
        assert (got[0] if got else None) == full_scan(exprs), exprs
        assert (AC.pick_snapshot_with(batch, exprs, [])[0] if got else None) == \
            (got[0] if got else None), "the memo must not change the answer"
    print("  PASS: the posting-list selection is the full scan's answer")


def test_the_memos_are_dropped_when_the_index_is_rebuilt(tmp_path):
    _reset()
