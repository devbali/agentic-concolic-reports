def test_heartbeat_is_silent_when_a_phase_finishes_inside_one_interval():
    """The suite, and every small corpus, must print what it always did."""
    lines = []
    p = AC._Progress("phase-x", 3, every=60.0, out=lines.append)
    for _ in range(3):
        p.tick()
    p.done()
    assert lines == [], lines
    print("  PASS: a short phase adds no output")


def test_heartbeat_names_the_phase_items_elapsed_and_rss():
    lines = []
    p = AC._Progress("corpus-index", 4, every=0.0, out=lines.append)
    p.every = 1e-9                     # beat on every tick
    for _ in range(4):
        p.tick()
    p.done("note")
    assert len(lines) == 5, lines      # 4 beats + the closing line
    assert lines[0].startswith("  [corpus-index] ... 1/4 "), lines[0]
    for tag in ("elapsed", "rate", "rss"):
        assert tag in lines[0], lines[0]
    assert lines[-1].startswith("  [corpus-index] done 4/4 "), lines[-1]
    assert lines[-1].endswith("note"), lines[-1]
    print("  PASS: the heartbeat names the phase, the count, elapsed and RSS")


def test_heartbeat_is_disabled_by_zero_and_by_the_env_var(monkeypatch):
    lines = []
    p = AC._Progress("phase-x", 2, every=0, out=lines.append)
    p.tick(); p.tick(); p.done()
    assert lines == []
    monkeypatch.setenv(AC.HEARTBEAT_ENV, "0")
    q = AC._Progress("phase-y", 2, out=lines.append)
    assert q.every == 0
    monkeypatch.setenv(AC.HEARTBEAT_ENV, "not-a-number")
    assert AC._Progress("phase-z", 2, out=lines.append).every == AC.HEARTBEAT_DEFAULT_S
    print("  PASS: ACHK_HEARTBEAT_S=0 disables it; garbage falls back to the default")


def test_corpus_index_heartbeats_and_names_itself(tmp_path, monkeypatch):
    _reset()
    batch = _corpus(tmp_path, 5)
    monkeypatch.setenv(AC.HEARTBEAT_ENV, "0.000001")
    out = []
    monkeypatch.setattr("builtins.print", lambda *a, **k: out.append(" ".join(map(str, a))))
    AC.corpus_index(batch)
    assert any(line.strip().startswith("[corpus-index]") for line in out), out
    print("  PASS: the index phase reports progress under its own name")


