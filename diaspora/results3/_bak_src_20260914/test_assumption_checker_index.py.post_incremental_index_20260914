def test_derive_checkpoint_off_by_default(tmp_path, monkeypatch):
    monkeypatch.delenv(AC.DERIVE_CKPT_ENV, raising=False)
    _reset()
    batch = _corpus(tmp_path, 4)
    monkeypatch.setattr(AC, "run_probe", lambda *a, **k: {})
    AC.run_declared({"batch_dir": batch, "runner": "/bin/true"},
                    [{"type": "UntrackedPathAssumption", "expr": "(a > 0)"}])
    assert AC._DERIVE_CK is None
    assert not [f for f in os.listdir(batch) if not f.startswith("dump_")]
    print("  PASS: no variable -> the derivation writes nothing")


def _confinement(batch):
    return {"type": "ConfinementAssumption", "expr_a": "(a > 0)", "expr_b": "(b0 == 1)",
            "footprint_a": ["Post.find | SELECT 0 | "], "footprint_b": ["Post.find | SELECT 1 | "],
            "enabling_a": {"Post.find | SELECT 0 | ": "taken"},
            "enabling_b": {"Post.find | SELECT 1 | ": "taken"},
            "producers": {}, "gates": {}}


def test_a_recorded_derivation_is_replayed_without_reparsing_one_dump(tmp_path, monkeypatch):
    """The representatives AND their flipped seed dicts must come back exactly,
    rebuilt from the index rather than from the dumps."""
    _reset()
    batch = _corpus(tmp_path, 30)
    ck = str(tmp_path / "derive.jsonl")
    monkeypatch.setenv(AC.DERIVE_CKPT_ENV, ck)
    monkeypatch.setattr(AC, "run_probe", lambda *a, **k: {})
    decl = [_confinement(batch)]
    cfg = {"batch_dir": batch, "runner": "/bin/true"}

    AC.run_declared(cfg, decl)
    first = dict(AC._PROFILE_REPS)
    assert first, "the run must have derived at least one decision"
    assert os.path.exists(ck)

    def _rerun(with_ck):
        _reset()
        if with_ck:
            monkeypatch.setenv(AC.DERIVE_CKPT_ENV, ck)
        else:
            monkeypatch.delenv(AC.DERIVE_CKPT_ENV, raising=False)
        AC.corpus_index(batch)              # the index is not what is tested here
        n = {"loads": 0}
        real = AC.load_dump
        monkeypatch.setattr(AC, "load_dump",
                            lambda p: (n.__setitem__("loads", n["loads"] + 1), real(p))[1])
        AC.run_declared(cfg, decl)
        monkeypatch.undo()
        monkeypatch.setattr(AC, "run_probe", lambda *a, **k: {})
        return n["loads"], dict(AC._PROFILE_REPS)

    resumed, reps = _rerun(True)
    fresh, reps_fresh = _rerun(False)
    assert reps == first, "the replayed representatives must be identical"
    assert reps == reps_fresh, "and identical to deriving them again from the dumps"
    # what is left is the PAIR's own snapshot, one per member — the
    # per-profile parses, which are the whole cost, are gone.
    assert resumed == 2 and fresh > resumed, (resumed, fresh)
    print(f"  PASS: the derivation resumes ({resumed} dump opens, {fresh} without it)")


def test_a_changed_declared_set_discards_the_derivation(tmp_path, monkeypatch):
    _reset()
    batch = _corpus(tmp_path, 6)
    ck = str(tmp_path / "derive.jsonl")
    monkeypatch.setenv(AC.DERIVE_CKPT_ENV, ck)
    monkeypatch.setattr(AC, "run_probe", lambda *a, **k: {})
    cfg = {"batch_dir": batch, "runner": "/bin/true"}
    AC.run_declared(cfg, [_confinement(batch)])
    _reset()
    monkeypatch.setenv(AC.DERIVE_CKPT_ENV, ck)
    other = dict(_confinement(batch), expr_b="(b1 == 1)")
    AC.run_declared(cfg, [other])
    assert os.path.exists(ck + ".stale"), "a different declared set must not be resumed"
    print("  PASS: the derivation checkpoint is keyed on the declared set too")
