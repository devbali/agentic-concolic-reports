def test_profile_representatives_are_derived_once_per_decision(tmp_path):
    _reset()
    batch = _corpus(tmp_path, 6)
    fp = {"Post.find | SELECT 0 | "}
    en = {"Post.find | SELECT 0 | ": "taken"}
    n = {"calls": 0}
    real = AC.load_dump
    AC.load_dump = lambda p: (n.__setitem__("calls", n["calls"] + 1), real(p))[1]
    try:
        first = AC._profile_representatives(batch, "(a > 0)", fp, en)
        after_first = n["calls"]
        again = AC._profile_representatives(batch, "(a > 0)", fp, en)
    finally:
        AC.load_dump = real
    assert again is first, "the second pair must reuse the decision's derivation"
    assert n["calls"] == after_first, "and must not re-parse a single dump"
    print("  PASS: a decision's profile representatives are derived once, not once per pair")


def test_profile_representatives_agree_with_the_full_scan(tmp_path):
    """The posting-list selection must be the scan it replaced, candidate for
    candidate: same representatives, same order, same flips, same count."""
    _reset()
    batch = _corpus(tmp_path, 12)

    def reference(expr, fp, enabling):
        rows = AC.corpus_index(batch)
        tidx = AC._TRACE_INDEX[batch]
        dim = AC.expr_dimension(expr)
        cands = {}
        for p, seeds, scen, _e in rows:
            digest, shapes, pcs = tidx[p]
            side = AC._side_of(pcs, expr)
            if len(side) != 1:
                continue
            s = "taken" if True in side else "not_taken"
            carried = frozenset(z for z in shapes if z in fp and enabling.get(z) == s)
            if not carried:
                continue
            best = cands.get(digest)
            if best is None or len(seeds) > len(best[1]):
                cands[digest] = (p, seeds, scen, carried, s)
        ranked = sorted(cands.values(), key=lambda c: (-len(c[3]), -len(c[1]), c[0]))
        return ([(p, scen, carried, s,
                  AC.flipped_seeds(AC.load_dump(p), dict(seeds), expr, dim))
                 for p, seeds, scen, carried, s in ranked], len(cands))

    for expr in ("(a > 0)", "(b0 == 1)", "(b1 == 1)", "(never == 1)"):
        for fp, en in (({"Post.find | SELECT 0 | "}, {"Post.find | SELECT 0 | ": "taken"}),
                       ({"Post.find | SELECT 0 | ", "Post.find | SELECT 1 | "},
                        {"Post.find | SELECT 0 | ": "taken",
                         "Post.find | SELECT 1 | ": "not_taken"}),
                       (set(), {})):
            AC._PROFILE_REPS.clear()
            assert AC._profile_representatives(batch, expr, fp, en) == \
                reference(expr, fp, en), (expr, fp)
    print("  PASS: the memoised selection is the full scan, candidate for candidate")


