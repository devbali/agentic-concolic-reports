#!/usr/bin/env python3
"""Extract one endpoint's policy from its concolic corpus.

    extract_policy.py <endpoint> [--out PATH] [--summary PATH]
                      [--skip-subsume] [--sample N] [--app-config PATH]

ONE script for every endpoint. It replaces the six near-identical
`_extract_<endpoint>_streaming.py` drivers and the two in-process monkeypatch
layers (`_experiment/variant_d/assoc_fold.py`, `_blockaid_fold.py`) that grew
up around them: ~3 600 lines whose only reason to exist was that
`src/queries_from_runs` could not be edited. The folds they carried are now IN
`src/queries_from_runs` where they belong —

  * value-note producers (assoc_fold's whole purpose: a `symbolic_vars` note
    is a producing query, so the bind is a JOIN) -> `transform.py`
    `RunTransformer.bind_producers`;
  * the solver-wrapped string literal in a path condition -> `pcs.parse_pc`.

so this driver does no patching at all: it reads dumps, transforms them with
the stock `RunTransformer`, dedups, prunes subsumed queries and writes the
file. Endpoint-specific knowledge is exactly two things, both read from disk:
the corpus directory and the endpoint's `POLICY_HEADER.txt`.
"""
import dataclasses
import glob
import json
import os
import random
import sys

R3 = "/home/dev/project/reports/diaspora/results3"
DEFAULT_CONFIG = "/home/dev/project/reports/diaspora/queries_config/app.json"


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(__doc__)
    endpoint = args[0]

    def opt(n, d=None):
        return args[args.index(n) + 1] if n in args else d

    os.environ.setdefault("QFR_APP_CONFIG", opt("--app-config", DEFAULT_CONFIG))
    from queries_from_runs.dump import _load_run, discover_param_pool
    from queries_from_runs.transform import RunTransformer
    from queries_from_runs import subsume as subsume_mod

    batch = os.path.join(R3, endpoint)
    out_path = opt("--out", os.path.join(R3, "queries_from_runs", endpoint + ".sql"))
    summary_path = opt("--summary",
                       os.path.join(R3, "queries_from_runs", "_summary_%s.json" % endpoint))
    sample = int(opt("--sample", "0"))

    paths = sorted(glob.glob(os.path.join(batch, "dump_*.json")))
    population = len(paths)
    if sample and sample < population:
        random.Random(20260915).shuffle(paths)
        paths = sorted(paths[:sample])
    print(f"{endpoint}: {population} dumps in corpus, {len(paths)} read", flush=True)

    param_pool = discover_param_pool(list(paths))
    seen, errors, flags, placeholders, skipped = {}, [], {}, set(), {}
    n_raw = n_runs = 0
    for i, p in enumerate(paths):
        run = _load_run(p)
        if run is None:
            continue
        n_runs += 1
        try:
            rq = RunTransformer(run, param_pool=param_pool).transform_all()
        except Exception as e:                                  # noqa: BLE001
            errors.append(f"{os.path.basename(p)}: {type(e).__name__}: {e}")
            continue
        errors.extend(f"{os.path.basename(p)}: {m}" for m in rq.errors)
        for expr in rq.skipped_pcs:
            skipped[expr[:80]] = skipped.get(expr[:80], 0) + 1
        for qy in rq.queries:
            n_raw += 1
            for f in qy.flags:
                flags[f] = flags.get(f, 0) + 1
            placeholders.update(qy.placeholders)
            seen.setdefault(qy.sql, qy)
        if (i + 1) % 5000 == 0:
            print(f"  {i + 1}/{len(paths)} dumps, {len(seen)} distinct", flush=True)

    deduped = sorted(seen.values(), key=lambda qy: (-qy.n_tables, qy.sql))

    # -- subsumption prune ------------------------------------------------
    final, n_dropped, subsume_ran, subsume_errors = deduped, 0, None, {}
    if len(deduped) > 1:
        sqls = [qy.sql for qy in deduped]
        eligible = [not qy.placeholders and "type-mismatched-join" not in qy.flags
                    for qy in deduped]
        can_subsume = [
            "finder-without-where" not in qy.flags and "unscoped" not in qy.flags
            for qy in deduped]
        try:
            if "--skip-subsume" in args:
                dropped = subsume_mod._drop_from_pairs(
                    subsume_mod.syntactic_subsumed_pairs(sqls, can_subsume), set())
                final = [qy for k, qy in enumerate(deduped) if k not in dropped]
                subsume_ran = None
                errors.append("subsumption SOLVER STAGE NOT ATTEMPTED (--skip-subsume)")
            else:
                survivors, _pairs, subsume_errors = subsume_mod.prune_subsumed(
                    sqls, eligible=eligible, can_subsume=can_subsume)
                final = [deduped[k] for k in survivors]
                subsume_ran = True
            n_dropped = len(deduped) - len(final)
        except Exception as e:                                  # noqa: BLE001
            subsume_ran = False
            errors.append(f"subsumption failed: {type(e).__name__}: {e}")

    # -- emit -------------------------------------------------------------
    lines = []
    for qy in final:
        for f in sorted(qy.flags):
            lines.append("-- NOTE: flag " + f)
        if qy.placeholders:
            lines.append("-- NOTE: unresolved symbolic binds kept as placeholders: "
                         + ", ".join("_" + x for x in qy.placeholders))
        lines.append(qy.sql.rstrip(";") + ";")
        lines.append("")
    if not final:
        lines = ["-- no SELECT queries recorded for this endpoint", ""]

    header_src = os.path.join(batch, "POLICY_HEADER.txt")
    if os.path.exists(header_src):
        header = open(header_src).read().rstrip("\n").split("\n")
    else:
        header = [f"-- {endpoint}", "-- !!! NO POLICY_HEADER.txt FOR THIS ENDPOINT !!!"]
        print("*** NO POLICY_HEADER.txt at " + header_src, flush=True)
    header += [
        "--",
        f"-- Extracted from {batch}: {population} dumps in corpus, {len(paths)} read,",
        f"--   {n_runs} runs loaded, {n_raw} raw queries, {len(deduped)} distinct,",
        f"--   {n_dropped} subsumed, {len(final)} views.",
        f"--   subsume_ran={subsume_ran} (True=ran, None=syntactic only, False=failed)",
        "--   fold: src/queries_from_runs, stock RunTransformer (no patches)",
        "",
    ]
    with open(out_path, "w") as f:
        f.write("\n".join(header + lines))

    with open(summary_path, "w") as f:
        json.dump({endpoint: {
            "out_path": out_path, "population": population, "n_dumps_read": len(paths),
            "n_runs_loaded": n_runs, "n_queries_raw": n_raw,
            "n_queries_deduped": len(deduped), "n_queries_final": len(final),
            "n_subsumed_dropped": n_dropped, "subsume_ran": subsume_ran,
            "placeholders": sorted(placeholders), "flags": flags,
            "skipped_pc_shapes": skipped, "subsume_errors": subsume_errors,
            "errors": errors[:400], "n_errors": len(errors),
        }}, f, indent=1)

    unparseable = [e for e in errors if "unparseable note" in e]
    print(f"{endpoint}: {len(final)} views ({len(deduped)} distinct, {n_dropped} subsumed) "
          f"from {n_runs}/{len(paths)} dumps; placeholders={len(placeholders)}; "
          f"errors={len(errors)}")
    if unparseable:
        print(f"*** RED: {len(unparseable)} UNPARSEABLE NOTES — statements the app "
              f"issued are MISSING from this policy ***")
    print("VERDICT_EXTRACTED=" + out_path)


if __name__ == "__main__":
    main()
