# frozen_string_literal: true
#
# autolab_dse.rb — the generic, endpoint-independent half of a concolic runner.
#
# The two known-good batches (reports/diaspora/results4/comments_index and
# .../aspect_memberships_create) each carry a ~600-line run_dse.rb, of which
# roughly 450 lines are *identical* algorithm: the harness factory, the
# symbolic-principal wiring, the term-to-string renderer, the four flip
# matchers and the prefix-directed worklist. Only a ~30-line CFG differs.
#
# This file is that identical remainder, lifted verbatim in behaviour so a
# generated runner is thin. Every comment marked "GROUND TRUTH" records a fact
# those two batches paid for; do not simplify one away without re-measuring.
#
# NOTHING endpoint-specific belongs here. Per-endpoint target declarations and
# mocks live in reports/autolab/targets/endpoints/<id>.rb (the peer library),
# loaded through targets/registry.json by `boot!`.
#
# Usage from a generated runner:
#
#   require "/home/dev/project/reports/autolab/entrypoints/lib/autolab_dse"
#   AutolabDSE.boot!("comments_index")
#   AutolabDSE.explore(
#     entry:            "comments_index",
#     controller_class: "CommentsController",
#     action:           :index,
#     format:           :json,
#     signed_in:        false,
#     params:           { post_id: { sym: "SYM_PARAM_post_id", default: "5" } }
#   )

require "json"
require "set"
require "digest"
require "fileutils"

module AutolabDSE
  # E2E FIX-6: a NAMED outcome for "the app asked an anonymous request to
  # authenticate". Without it the rig's missing Warden middleware surfaced
  # as `Devise::MissingWarden`, which reads like an application fault and is
  # not one.
  class AuthenticationRequired < StandardError; end

  RUNTIME  = "/home/dev/project/src_new/runtimes/ruby_runtime"
  AUTOLAB  = "/home/dev/project/reports/autolab"
  REGISTRY = File.join(AUTOLAB, "targets", "registry.json")

  module_function

  # -----------------------------------------------------------------------
  # boot
  # -----------------------------------------------------------------------

  # Load the Rails environment, the symbolic runtime and the target library.
  #
  # ORDER MATTERS (GROUND TRUTH from both reference batches):
  #   call_interceptor first — it require_relative's path_condition, base, int,
  #   string, bool, symbolic_func and term — then the individual type files,
  #   then the targets.
  #
  # `require "./config/environment"` is cwd-relative and only resolves because
  # scripts/diaspora-concolic cd's into the diaspora app first.
  def boot!(endpoint_id)
    require "./config/environment"

    require File.join(RUNTIME, "call_interceptor")
    require File.join(RUNTIME, "base")
    require File.join(RUNTIME, "int")
    require File.join(RUNTIME, "string")
    require File.join(RUNTIME, "bool")
    require File.join(RUNTIME, "list")
    require "action_controller/test_case"

    ActiveRecord::Base.establish_connection(:concolic)
    ActionController::Base.allow_forgery_protection = false
    install_asset_helper_stubs!
    install_runtime_compat_shims!
    $interceptor = CallInterceptor.instance

    load_targets!(endpoint_id)
    $interceptor
  end

  # Load the shared target library through the peer-owned registry, rather
  # than by copying any batch's targets.rb. Core modules install first, the
  # endpoint's override second; last declaration for a (class, method) wins,
  # which is how an override beats the core.
  def load_targets!(endpoint_id)
    unless File.exist?(REGISTRY)
      raise "targets registry not found at #{REGISTRY} — the shared targets " \
            "library must exist before a runner can be driven"
    end
    reg = JSON.parse(File.read(REGISTRY))

    core = reg["core"] or raise "registry has no `core` entry"
    require File.join(AUTOLAB, core["file"].sub(%r{\Atargets/}, "targets/"))
    Array(core["modules"]).each { |m| install_module!(m) }

    ep = (reg["endpoints"] || {})[endpoint_id]
    if ep.nil?
      install_candidate_principal_plumbing!
      warn "[autolab] no target override for #{endpoint_id} " \
           "(tier=candidate) — running on core targets only. Expect " \
           "unmocked call sites; that is a finding, not a crash to hide."
      @targets_tier = "candidate"
      return
    end
    require File.join(AUTOLAB, ep["file"])
    Array(ep["modules"]).each { |m| install_module!(m) }
    @targets_tier = ep["tier"] || "gold"
  end

  # -----------------------------------------------------------------------
  # candidate-tier principal plumbing  (e2e fix round 1, 2026-09-26)
  # -----------------------------------------------------------------------
  #
  # WHY THIS EXISTS, MEASURED (reports/autolab/e2e/probes/probe_principal.out):
  #
  #   User.to_adapter.get(uid)      -> a symbolic User            [ok]
  #   record.authenticatable_salt   -> SymbolicSubstring of the SYMBOLIC
  #                                    encrypted_password column, concrete
  #                                    value "SYM_RESULT_ActiveRecord__Find"
  #   salt == "concolicsalt"        -> concrete false
  #   User.serialize_from_session   -> nil
  #   current_user.language         -> NoMethodError: nil:NilClass
  #
  # `run_one` resolves the principal through the REAL Devise path
  # (`User.serialize_from_session(uid, "concolicsalt")`, below) precisely so
  # that the two statements a real signed-in request issues are recorded
  # rather than swallowed — but devise-4.7.1
  # `lib/devise/models/authenticatable.rb:236-239` keeps the record only if
  # `record.authenticatable_salt == salt`, and against a symbolic
  # `encrypted_password` that compare is always false.  The gold endpoint
  # `comments_index` carries a leaf shim for exactly this
  # (`targets/endpoints/comments_index.rb`, the "(a) salt leaf shim" block);
  # the shared core does not, so every CORE-ONLY signed-in endpoint resolved
  # its principal to nil and died in `set_locale` before the action ran.
  # Measured blast radius before the fix: 113 of the 114 signed-in endpoints.
  #
  # IT IS INSTALLED HERE, NOT IN THE TARGET LIBRARY, AND ONLY FOR
  # candidate-tier endpoints:
  #   * it is a `prepend`, not a `declare_target`, so the declaration table
  #     is unchanged (86 names) and the D5 double-declaration wrap cannot
  #     fire;
  #   * an endpoint WITH an override installs its own (comments_index does),
  #     and this never runs for one, so no closed endpoint's evidence moves;
  #   * it is runner-local plumbing of the same kind `run_one` already does
  #     for `authenticate_user!`.
  def install_candidate_principal_plumbing!
    return unless defined?(::User)

    unless ::User.instance_variable_get(:@autolab_candidate_salt_shim)
      shim = Module.new do
        def authenticatable_salt
          if defined?(::ConcreteSymbolicString)
            ::ConcreteSymbolicString.build(
              "concolicsalt", name: nil,
              note: "User#authenticatable_salt leaf (encrypted_password[0,29] slice)")
          else
            "concolicsalt"
          end
        end
      end
      ::User.prepend(shim)
      ::User.instance_variable_set(:@autolab_candidate_salt_shim, true)
      warn "[autolab] candidate principal plumbing: authenticatable_salt leaf " \
           "shim installed (see install_candidate_principal_plumbing!)"
    end

    # -------------------------------------------------------------------
    # FIX-2: devise_mapping must hand Devise the MODEL CLASS
    # -------------------------------------------------------------------
    # `core.rb:1988-2003` builds a closure-local `dev_stub = Object.new` and
    # gives it `def dev_stub.to(*_); self; end`, so `mapping.to` returns the
    # STUB where Devise expects the resource class. MEASURED: all six
    # endpoints that call `devise_mapping` stop with a NoMethodError on a bare
    # `#<Object>`, and every missing name is a `User` CLASS method --
    #   sessions_new             authentication_keys
    #     (devise-4.7.1/lib/devise/parameter_sanitizer.rb:158)
    #   registrations_new        new_with_session
    #   devise_passwords_new     new
    #   devise_passwords_create  send_reset_password_instructions
    #   devise_passwords_edit    reset_password_by_token
    #   devise_passwords_update  reset_password_by_token / new
    # -- and all five are present on `::User` (measured, probe_fixes.out).
    #
    # The stub is closure-local, so it cannot be reached; the target is
    # RE-DECLARED instead, which the registry names as the override mechanism
    # ("Last declaration for a (class, method) wins"). It returns the app's
    # OWN `Devise.mappings[:user]`, which exists in the booted app and whose
    # `.to` IS `User` (measured). Same kind and same declared type, so the
    # declaration table keeps its shape.
    if defined?(::DeviseController) && defined?(::Devise) &&
       !::ConcolicTargets.instance_variable_get(:@autolab_candidate_devise_mapping)
      mapping = begin
        ::Devise.mappings[:user]
      rescue StandardError
        nil
      end
      if mapping
        $interceptor.declare_target(
          ::DeviseController, :devise_mapping,
          kind: CallInterceptor::SHIM, type: "opaque",
          returns: ->(_r, _a, _n) { mapping })
        ::ConcolicTargets.instance_variable_set(:@autolab_candidate_devise_mapping, true)
        warn "[autolab] candidate principal plumbing: devise_mapping re-declared " \
             "to the real Devise.mappings[:user] (to == #{mapping.to})"
      end
    end

    # -------------------------------------------------------------------
    # FIX-3: principal-column pins (users.language, profiles.gender)
    # -------------------------------------------------------------------
    # MEASURED (e2e/fixtrial, admin_pods_index, run auth_json_dse0001, with
    # FIX-1 in place and nothing else): once the principal resolves, the very
    # next wall is
    #   NotImplementedError: SymbolicString comparison (!=) with non-string
    #     (FalseClass) is not supported
    #   src_new/runtimes/ruby_runtime/string.rb:413 check_string_operand!
    # reached from `I18n.locale = current_user.language`
    # (app/controllers/application_controller.rb:102 set_locale) through
    # i18n's `enforce_available_locales!`.
    #
    # BOTH gold batches carry exactly this pin and both record the same
    # rationale: targets/endpoints/aspect_memberships_create.rb:408-441
    # ("Principal-column domains for the before_action chain ... this is NOT
    # new modelling -- it is the SAME two columns, on the SAME devise
    # principal, reached by the SAME two ApplicationController callbacks"),
    # ported there from results3/comments_index. The two callbacks live in
    # ApplicationController, so every signed-in diaspora endpoint runs them;
    # that is why the pin is app-wide rather than endpoint-specific.
    #
    # users.language keeps the measured THREE-ARM domain, so a candidate
    # endpoint agrees with the gold ones rather than inventing a narrower
    # world:
    #   "pl" available AND inflected -> set_grammatical_gender runs and reads
    #        the principal's profile
    #   "xx" syntactically fine, NOT in I18n.available_locales -> I18n.locale=
    #        raises I18n::InvalidLocale before the action body
    #   "en" available, not inflected -> the callback does nothing
    # The two compares that select the arm ARE the decision and are recorded
    # as path conditions on the column's own variable before it is
    # concretised.
    #
    # profiles.gender is a PIN LEDGER entry, pinned "male", for the reason the
    # gold batch gives: both arms of the `gender.empty?` compare reach only
    # in-memory I18n inflector lookups -- no statement, no association -- and
    # `String#tr` on a SymbolicString returns a bare subclass allocation with
    # no @value, which turns the callback into a wall instead of a decision.

    # -------------------------------------------------------------------
    # FIX-9: Gate 1b's representative must be reachable
    # -------------------------------------------------------------------
    # `SymbolicList#each` / `#map` are in the runtime's LIST_STUBS and raise
    # (`src_new/runtimes/ruby_runtime/list.rb:285-311`, "contents out of
    # scope"), so the representative row core.rb's `records` mock attaches
    # "so SQL-free display/serialisation iteration completes" could not be
    # reached by anything. MEASURED as the wall on every endpoint that
    # materialises a relation, once FIX-1/3/4/7 let one be materialised.
    #
    # `targets/endpoints/comments_index.rb:780-860` already defines the class
    # core.rb:1482 looks for; it lives in ONE endpoint's layer. This is the
    # MINIMAL version of it, installed only when that one is absent.
    #
    # NO `include Enumerable`, verbatim from that file's reasoning: a module
    # included into a SUBCLASS is inserted BEFORE the superclass, so
    # `Enumerable#any?`/`#none?`/`#count`/`#first` would SHADOW the
    # `SymbolicList` implementations that RECORD `(len(X) != 0)` -- silently
    # dropping path conditions on a run that still looks green (that batch
    # measured 8 PCs falling to 4). It would also re-enable `#include?` and
    # `#to_a`, which the runtime raises on by design.
    #
    # `each` AND `map` both record the same canonical compare the runtime's
    # own `any?`/`none?` record (list.rb:163-172), because a JSON render
    # reaches a collection through `map` and never compares its length
    # otherwise (comments_index D9).
    unless defined?(::IterableSymbolicList)
      ::Object.const_set(:IterableSymbolicList, Class.new(SymbolicList) do
        def each
          return to_enum(:each) unless block_given?
          nonempty = concrete_length != 0
          record!("(#{@symbolic_len} != 0)", "each", taken: nonempty)
          yield @representative if nonempty && @representative
          self
        end

        def map
          return to_enum(:map) unless block_given?
          nonempty = concrete_length != 0
          record!("(#{@symbolic_len} != 0)", "map", taken: nonempty)
          (nonempty && @representative) ? [yield(@representative)] : []
        end
        alias_method :collect, :map

        # Ruby's own `[].first` is nil and so is AR's; every OTHER rep-less
        # access still raises loudly. Same carve-out comments_index makes.
        def first(*args)
          return nil if args.empty? && @representative.nil? && concrete_length.zero?
          super
        end
      end)
      warn "[autolab] candidate principal plumbing: IterableSymbolicList defined"
    end

    return unless defined?(::ConcolicTargets)
    unless ::ConcolicTargets.instance_variable_get(:@autolab_candidate_pins)
      pins = Module.new do
        def symbolic_instance(klass, base_name, sql)
          obj = super
          attrs = (obj.respond_to?(:concolic_attrs) ? obj.concolic_attrs : nil)
          return obj unless attrs.is_a?(Hash)
          if klass.name == "User" && attrs["language"].respond_to?(:value)
            lang = attrs["language"]
            attrs["language"] = if lang == "pl"
                                  "pl"
                                elsif lang == "xx"
                                  "xx"
                                else
                                  "en"
                                end
            obj.define_singleton_method(:language) { attrs["language"] }
          end
          if klass.name == "Profile" && attrs["gender"].respond_to?(:value)
            attrs["gender"] = "male"
            obj.define_singleton_method(:gender) { attrs["gender"] }
          end
          obj
        end
      end
      ::ConcolicTargets.singleton_class.prepend(pins)
      ::ConcolicTargets.instance_variable_set(:@autolab_candidate_pins, true)
      warn "[autolab] candidate principal plumbing: users.language 3-arm "            "domain + profiles.gender pin installed"
    end

    # -------------------------------------------------------------------
    # FIX-4: name the devise session lookup, and stop branching on it
    # -------------------------------------------------------------------
    # Two problems the gold batches already solved and a candidate endpoint
    # inherits neither of:
    #
    # (a) NAMING. The ONE `.first` inside OrmAdapter::ActiveRecord#get takes
    #     the shared `first_1` ordinal, so the endpoint's OWN first finder
    #     becomes `first_2` and every note/var name shifts by one.
    # (b) A DECISION THAT IS NOT THE ENDPOINT'S. `finder_mock` records a
    #     `<name>_not_found` path condition, so half the exploration budget
    #     goes on "the session failed to resolve" -- MEASURED in the trial:
    #     of 3 runs on admin_pods_index, run 2 took the `not_found == true`
    #     seed and died at `set_locale` with a nil principal again. Devise's
    #     middleware 401s a request whose session does not resolve BEFORE the
    #     controller runs, so that arm is auth plumbing, not endpoint logic.
    #
    # The fix is the one both gold batches carry verbatim
    # (targets/endpoints/aspect_memberships_create.rb:1205-1253,
    #  targets/endpoints/comments_index.rb:2012-2060): a call-site-stable
    # alias declared as its OWN target_function, whose mock mints the users
    # SELECT note but pins the record found and persisted. THE STATEMENT IS
    # STILL RECORDED -- only the not_found DECISION is suppressed.
    return unless defined?(::OrmAdapter::ActiveRecord) && defined?(::ActiveRecord::FinderMethods)
    fm = ::ActiveRecord::FinderMethods
    unless fm.method_defined?(:devise_user_first)
      fm.send(:alias_method, :devise_user_first, :first)
    end
    unless ::ConcolicTargets.instance_variable_get(:@autolab_candidate_devise_first)
      $interceptor.declare_target(
        fm, :devise_user_first,
        kind: CallInterceptor::TARGET_FUNCTION, type: "obj<?>",
        returns: lambda do |receiver, args, name|
          ct = ::ConcolicTargets
          u = ct.symbolic_instance(ct.model_class(receiver), name,
                                   ct.sql_for(receiver, args))
          if u.respond_to?(:define_singleton_method)
            u.define_singleton_method(:persisted?)  { true }
            u.define_singleton_method(:new_record?) { false }
          end
          u
        end)
      ::OrmAdapter::ActiveRecord.prepend(OrmAdapterGetNaming) unless
        ::OrmAdapter::ActiveRecord < OrmAdapterGetNaming
      ::ConcolicTargets.instance_variable_set(:@autolab_candidate_devise_first, true)
      warn "[autolab] candidate principal plumbing: devise_user_first "            "declared; OrmAdapter#get routed to it"
    end
  end

  # Byte-faithful to orm_adapter-0.5.0's OrmAdapter::ActiveRecord#get, with
  # the one `.first` renamed. Same module both gold batches install.
  module OrmAdapterGetNaming
    def get(id)
      klass.where(klass.primary_key => wrap_key(id)).devise_user_first
    end
  end

  # e2e FIX-12 (2026-09-26). This CHECKOUT has no frontend assets, by its own
  # Gemfile header: "Minimal Gemfile for concolic analysis -- strips dead
  # diaspora-foundation gem source and frontend-only assets. Keeps only
  # backend gems needed to load controllers/models/services and drive
  # ActiveRecord queries."
  #
  # `app/views/layouts/application.html.haml:11` is
  # `= javascript_include_tag :main`, and `app/assets/javascripts/main.js:7`
  # is `//= require underscore`, which Sprockets cannot resolve. MEASURED:
  # `home_show`, `home_podmin` and `streams_public` all stop with
  # `ActionView::Template::Error: couldn't find file 'underscore' with type
  # 'application/javascript'`. The tag is in the SHARED LAYOUT, so it is on
  # the path of every HTML-rendering endpoint and aborts the render BEFORE
  # any query the template would have issued.
  #
  # The asset pipeline issues no SQL and decides nothing symbolic. An empty
  # tag restores the behaviour of a deployment that has its assets -- the
  # deployment this analysis is about -- rather than modelling one with no
  # JavaScript. IN THE RIG ONLY: nothing under app/ is touched.
  #
  # NARROW ON PURPOSE: only the two helpers measured to abort a render. Any
  # other asset helper that raises will show up as its own stopping site with
  # its own backtrace frame, which is how it should be found.
  # e2e FIX-7 + FIX-9 (2026-09-26), RUNNER-LOCAL. Both repair calls that
  # `targets/core.rb` makes into the symbolic runtime, and neither edits it:
  # `test/test_install.rb:156-166` asserts the library is byte-identical to
  # the results4 gold, and it is.
  def install_runtime_compat_shims!
    return unless defined?(::SymbolicVar)

    # FIX-7. `core.rb:1395` and `:1483` call `SymbolicVar.len_var_name(vn)`,
    # which `src_new/runtimes/ruby_runtime/base.rb:33` DELETED (DESIGN_IR
    # §4.1.1c change 3 -- "a length is the `length` OPERATOR ... there is no
    # name to mint"), so every relation materialisation raised
    #   NoMethodError: undefined method `len_var_name' for SymbolicVar:Module
    # MEASURED in e2e/fixtrial as soon as the principal resolved; invisible
    # before that because nothing got far enough to materialise a relation.
    #
    # Both call sites use the result ONLY as a seed key. A seed key is this
    # library's own business, not the runtime's, and the spelling below is the
    # one `core.rb:98-124` already documents and `length_var?` already
    # accepts. Defined here rather than restored in the runtime: the runtime's
    # own test (`tests/test_name_boundary_seed.rb:116`) asserts the deletion,
    # and it is right to.
    unless ::SymbolicVar.respond_to?(:len_var_name)
      ::SymbolicVar.define_singleton_method(:len_var_name) do |var_name|
        "SYM_LEN_#{var_name}"
      end
      warn "[autolab] runtime compat: SymbolicVar.len_var_name re-provided " \
           "as a SEED KEY only (see install_runtime_compat_shims!)"
    end

    # FIX-9. `core.rb:1386-1389` says the `to_a`/`to_ary`/`records` mock
    # attaches "a single representative model row so SQL-free
    # display/serialisation iteration COMPLETES" -- but it builds a plain
    # `SymbolicList`, whose `each`/`map` are in `LIST_STUBS`
    # (`list.rb:285-311`) and raise "contents out of scope". The
    # representative existed and nothing could reach it. MEASURED: with FIX-7
    # in, `SymbolicList#each is not supported` at `list.rb:305` was the next
    # wall on every endpoint that materialises a relation.
    #
    # PREPENDED ON THE BASE CLASS, not defined on a subclass, because
    # core.rb hardcodes `SymbolicList.new` at :1395. A SUBCLASS'S OWN METHODS
    # STILL WIN over a module prepended to its parent, so
    # `comments_index`'s richer `IterableSymbolicList` (second representative,
    # M-13) is untouched where it is installed.
    #
    # Both methods record the SAME canonical compare the runtime's own
    # `any?`/`none?` record (`list.rb:163-172`), and `map` records it too
    # because a JSON render reaches a collection through `map` and never
    # compares its length otherwise (comments_index D9). NO `Enumerable` is
    # included anywhere: a module included into a subclass goes BEFORE the
    # superclass and would shadow the `any?`/`none?` that record the decision.
    if defined?(::SymbolicList) &&
       !::SymbolicList.instance_variable_get(:@autolab_iterable)
      iter = Module.new do
        def each
          return to_enum(:each) unless block_given?
          nonempty = concrete_length != 0
          record!("(#{@symbolic_len} != 0)", "each", taken: nonempty)
          yield @representative if nonempty && @representative
          self
        end

        def map
          return to_enum(:map) unless block_given?
          nonempty = concrete_length != 0
          record!("(#{@symbolic_len} != 0)", "map", taken: nonempty)
          (nonempty && @representative) ? [yield(@representative)] : []
        end
        alias_method :collect, :map

        # Ruby's own `[].first` is nil and so is AR's; every OTHER rep-less
        # access still raises loudly. Same carve-out comments_index makes.
        def first(*args)
          return nil if args.empty? && @representative.nil? && concrete_length.zero?
          super
        end
      end
      ::SymbolicList.prepend(iter)
      ::SymbolicList.instance_variable_set(:@autolab_iterable, true)
      warn "[autolab] runtime compat: SymbolicList#each/#map provided so Gate " \
           "1b's representative row is reachable"
    end
  end

  def install_asset_helper_stubs!
    return unless defined?(::ActionView::Base)
    return if ::ActionView::Base.instance_variable_get(:@autolab_asset_stubs)
    # e2e FIX-12 (2026-09-26), REVISED after the verification trial.
    #
    # THIS CHECKOUT HAS NO FRONTEND ASSETS, by its own Gemfile header:
    # "Minimal Gemfile for concolic analysis -- strips dead
    # diaspora-foundation gem source and frontend-only assets. Keeps only
    # backend gems needed to load controllers/models/services and drive
    # ActiveRecord queries."  `app/assets/config/manifest.js:4` links
    # `app/assets/javascripts/main.js`, whose line 7 is `//= require
    # underscore`, and Sprockets cannot resolve it. MEASURED stops:
    #   home_show, home_podmin, streams_public
    #     ActionView::Template::Error: couldn't find file 'underscore'
    #   manifest_show
    #     Sprockets::FileNotFound (no template at all --
    #     manifest_controller.rb:11 is `helpers.image_path(...)`)
    #
    # FIRST ATTEMPT, AND WHY IT WAS NOT ENOUGH. I stubbed
    # `javascript_include_tag` / `stylesheet_link_tag`, then added the
    # `*_path` family when `manifest_show` showed a second door. The
    # verification trial then showed a THIRD: `home_show` still stopped,
    # because `sprockets-rails-3.2.1/lib/sprockets/rails/helper.rb:135`
    # overrides `javascript_include_tag` and, when `request_debug_assets?`,
    # takes a branch through `lookup_debug_asset` that reaches Sprockets
    # WITHOUT going through `compute_asset_path` at all. Stubbing helpers one
    # at a time was chasing doors.
    #
    # SO THE SEAM IS STUBBED, NOT THE HELPERS. Everything that can reach
    # Sprockets from a view funnels through these five methods; with them
    # answered locally, no asset helper -- named or unnamed, in the app or in
    # a gem -- can reach the asset pipeline. The TAG HELPERS ARE LEFT ALONE,
    # so the rendered HTML keeps its real `<script>`/`<link>`/`<img>`
    # elements pointing at a plausible `/assets/...` path, rather than
    # becoming a document with no assets in it.
    #
    # The asset pipeline issues no SQL and decides nothing symbolic, so this
    # restores the behaviour of a deployment that HAS its assets -- the
    # deployment this analysis is about. IN THE RIG ONLY: nothing under app/
    # is touched.
    stubs = Module.new do
      # the one seam ActionView's own `asset_path` funnels through
      def compute_asset_path(source, _options = {})
        s = source.to_s
        s.start_with?("/", "http://", "https://", "//") ? s : "/assets/#{s}"
      end

      # the debug branch in sprockets-rails' own tag helpers
      def request_debug_assets?
        false
      end

      # every remaining door into the Sprockets environment. `nil` is the
      # documented "an asset we don't know about" answer (helper.rb:98-99).
      def resolve_asset_path(*_args)
        nil
      end

      def asset_digest_path(*_args)
        nil
      end

      def lookup_debug_asset(*_args)
        nil
      end

      def asset_integrity(*_args)
        nil
      end
    end
    ::ActionView::Base.prepend(stubs)
    ::ActionView::Base.instance_variable_set(:@autolab_asset_stubs, true)
    warn "[autolab] rig: the Sprockets seam is answered locally " \
         "(compute_asset_path / resolve_asset_path / lookup_debug_asset / " \
         "asset_digest_path / asset_integrity / request_debug_assets?) -- " \
         "this checkout strips frontend assets; see install_asset_helper_stubs!"
  rescue StandardError => e
    warn "[autolab] rig: could not stub the asset seam: #{e.class}: #{e.message}"
  end

  def install_module!(name)
    mod = Object.const_get(name)
    mod.install!($interceptor)
  rescue NameError => e
    warn "[autolab] target module #{name} not installed: #{e.class}: #{e.message}"
  end

  def targets_tier
    @targets_tier || "unknown"
  end

  # -----------------------------------------------------------------------
  # harness
  # -----------------------------------------------------------------------

  # GROUND TRUTH: this is an ActionController::TestCase used purely as a rig
  # FACTORY — the action is then invoked DIRECTLY (`ctrl.send(action)`), not
  # routed. There is no verb, path, header or session in the dispatch; the
  # route only tells us which params to make symbolic.
  def make_harness(controller_class)
    # The rig's TestCase subclass is registered as a TOP-LEVEL constant, so
    # the namespace has to be flattened: Object.const_set cannot take
    # "Api::OpenidConnect::IdTokensControllerTest" (NameError: wrong constant
    # name). The two reference batches only ever drove top-level controllers,
    # so this case first appeared when the lab generalised to the 9
    # api/openid_connect and 11 admin/* actions.
    cname = controller_class.to_s.gsub("::", "").sub(/Controller\z/, "ControllerTest")
    Object.const_set(cname, Class.new(ActionController::TestCase)) unless Object.const_defined?(cname)
    test_class = Object.const_get(cname)
    test_class.instance_variable_set(:@concolic_ctrl, controller_class)
    def test_class.determine_default_controller_class(_name)
      @concolic_ctrl
    end
    tc = test_class.new("noop")
    tc.setup_controller_request_and_response
    tc.instance_variable_set(:@routes, Rails.application.routes)
    ctrl = tc.instance_variable_get(:@controller)
    ctrl.response = tc.instance_variable_get(:@response) # real render needs the response wired
    [ctrl, tc]
  end

  # -----------------------------------------------------------------------
  # PC term rendering
  # -----------------------------------------------------------------------

  # PC EXPRESSION SHAPE (DESIGN_IR §4.1.1c TERMS) — WITHOUT THIS THE DSE IS A
  # SINGLE RUN. The runtimes record a path condition's `expr` as a structured
  # TERM (a Hash), where they used to record the rendered string. Every flip
  # matcher below is a REGEX over that old spelling, so a Hash expr matches
  # nothing: flip_any returns nil, the PC is booked "unflippable", no child
  # seed is pushed, and the worklist drains after run 1 reporting
  # worklist_exhausted: true — a FALSE completion signal, not a visible
  # failure.
  def pc_expr_to_s(expr)
    return expr.to_s unless expr.is_a?(::Hash)
    return expr["sym"].to_s if expr.key?("sym")
    if expr.key?("lit")
      lit  = expr["lit"] || {}
      sort = lit["sort"]
      v    = lit["value"]
      return case sort
             when "str"  then "StringVal('#{v}')"
             when "bool" then (v ? "True" : "False")
             when "int"  then v.to_s
             when "null" then "None"
             else v.inspect
             end
    end
    op   = expr["op"].to_s
    args = expr["args"] || []
    rend = args.map { |a| pc_expr_to_s(a) }
    case op
    when "length" then "len(#{rend[0]})"
    when "not"    then "Not(#{rend[0]})"
    else
      rend.size == 2 ? "(#{rend[0]} #{op} #{rend[1]})" : "#{op}(#{rend.join(', ')})"
    end
  end

  def path_conditions(dump)
    (dump["events"] || [])
      .select { |e| e["type"] == "path_condition" }
      .map { |e| [pc_expr_to_s(e["expr"]), e["taken"] ? true : false] }
  end

  # NAME BOUNDARY: the runtimes mint a list's cardinality var as `SYM_LEN_X`;
  # the matchers are written in the old `len(X)` spelling.
  def canon_len(expr)
    expr.to_s.strip.gsub(/SYM_LEN_([A-Za-z0-9_]+)/, 'len(\1)')
  end

  # -----------------------------------------------------------------------
  # flip matchers
  # -----------------------------------------------------------------------

  # The principal's identity vars are NEVER reseeded: a concrete key folds
  # every signed-in view as `users.id = 1` instead of `_MY_UID`.
  PRINCIPAL = lambda do |v|
    v.include?("devise_user_first") || v.start_with?("SYM_USER_CI")
  end

  def flip_seed(expr, want_taken, vals = {})
    m = /\A\(([A-Za-z_][A-Za-z0-9_]*) (==|!=) (.+)\)\z/m.match(canon_len(expr))
    return nil unless m
    var, op, lit = m[1], m[2], m[3].strip
    want_taken = !want_taken if op == "!="

    if /\A[A-Za-z_][A-Za-z0-9_]*\z/.match?(lit) && lit != var && !%w[True False].include?(lit)
      free, anchor = if PRINCIPAL.call(var) && !PRINCIPAL.call(lit) && vals.key?(var)
                       [lit, vals[var]]
                     elsif PRINCIPAL.call(lit) && !PRINCIPAL.call(var) && vals.key?(lit)
                       [var, vals[lit]]
                     elsif vals.key?(lit) then [var, vals[lit]]
                     elsif vals.key?(var) then [lit, vals[var]]
                     end
      return nil if free.nil?
      av = anchor
      av = av.to_i if av.is_a?(String) && av =~ /\A-?\d+\z/
      return nil unless av.is_a?(Integer) || av.is_a?(String) || av == true || av == false
      other = case av
              when true, false then !av
              when Integer     then av + 1
              when String      then av.empty? ? "concolic_other" : ""
              end
      return { free => (want_taken ? av : other) }
    end

    parsed =
      case lit
      when "True"  then true
      when "False" then false
      when /\AStringVal\('(.*)'\)\z/m then Regexp.last_match(1)
      when /\A'(.*)'\z/m then Regexp.last_match(1)
      when /\A"(.*)"\z/m then Regexp.last_match(1)
      when /\A-?\d+\z/   then lit.to_i
      else return nil
      end

    alt = nil
    alt = "en" if var.end_with?("_language")

    value =
      if want_taken
        parsed
      else
        case parsed
        when true, false then !parsed
        when Integer     then parsed + 1
        when String      then alt || (parsed.empty? ? "concolic_other" : "")
        else return nil
        end
      end

    { var => value }
  end

  def flip_len_seed(expr, want_taken)
    m = /\A\((len\(.+\)) != 0\)\z/m.match(canon_len(expr))
    return nil unless m
    { m[1] => (want_taken ? 1 : 0) }
  end

  def flip_len_many_seed(expr, want_taken)
    m = /\A\((len\(.+\)) > 1\)\z/m.match(canon_len(expr))
    return nil unless m
    { m[1] => (want_taken ? 2 : 1) }
  end

  def flip_length_seed(expr, want_taken)
    m = /\A\(Length\(([A-Za-z_][A-Za-z0-9_]*)\) (<=|>=|==|!=|<|>) (-?\d+)\)\z/m.match(canon_len(expr))
    return nil unless m
    var, op, n = m[1], m[2], m[3].to_i
    len =
      case op
      when "<"  then want_taken ? n - 1 : n
      when "<=" then want_taken ? n     : n + 1
      when ">"  then want_taken ? n + 1 : n
      when ">=" then want_taken ? n     : n - 1
      when "==" then want_taken ? n     : n + 1
      when "!=" then want_taken ? n + 1 : n
      else return nil
      end
    len = 0 if len.negative?
    { var => ("g" * len) }
  end

  def flip_any(expr, want_taken, vals = {})
    flip_seed(expr, want_taken, vals) || flip_len_seed(expr, want_taken) ||
      flip_len_many_seed(expr, want_taken) || flip_length_seed(expr, want_taken)
  end

  def sig_of(pcs)
    pcs.map { |e, t| "#{e}:#{t}" }.join("|")
  end

  def digest(str)
    Digest::MD5.digest(str)
  end

  # -----------------------------------------------------------------------
  # one run
  # -----------------------------------------------------------------------

  # e2e FIX-11 (2026-09-26), RUNNER-LOCAL. A memo that claims to be per-run
  # and is not.
  #
  # `targets/endpoints/comments_index.rb:968` memoises a materialised relation
  # in `Thread.current[:comments_rows_memo]` and its own comment says the list
  # is "MEMOIZED by its own SQL for the life of the RUN". Nothing scoped it:
  # `Thread.current` belongs to the PROCESS and one process drives every run.
  # Because a memo HIT skips `ConcolicTargets.symbolic_instance` -- which is
  # where `SymbolicFunc.register_type` fires -- while
  # `SymbolicFunc.save_and_clear_types` empties the per-run type table, every
  # run after the first to materialise that relation emitted
  # `…records_1_row*` symbols typed `obj<Comment>` with no `Comment` in its
  # own type table, and `validate_provenance` REFUSED the dump (§5.2).
  #
  # MEASURED: 5 of comments_index's 12 dumps at MAX_RUNS=24. The mechanism was
  # read off the dumps, not inferred -- the FIRST run to call
  # `Relation#records` (dse0005) declares `Comment` and is accepted; dse0009,
  # 0016, 0019, 0022 and 0023 all call it, all emit the same 41 symbols, and
  # none declares `Comment`.
  #
  # CLEARED HERE, NOT FIXED THERE: `targets/endpoints/comments_index.rb` is
  # byte-identical to the results4 gold and `test/test_install.rb:156-166`
  # asserts that. The driver owns run boundaries -- it already clears
  # `CallInterceptor#@all_calls` between runs for the same reason -- so this
  # is where a per-run cache belongs.
  #
  # `core.rb:1928-1933`'s own loaded-target memo does scope itself, by run
  # label; the keys below are the ones that do NOT.
  PER_RUN_MEMO_KEYS = %i[
    comments_rows_memo
    concolic_loaded_target_memo
    concolic_autosave_seen
    concolic_autosave_depth
    concolic_pending_note
    concolic_finder_conds
    concolic_update_all_values
    concolic_write_args
  ].freeze

  def clear_per_run_memos!
    PER_RUN_MEMO_KEYS.each { |k| Thread.current[k] = nil }
  end

  # E2E INVENTORY ADDITION (2026-09-26, reports/autolab/e2e). ADDITIVE ONLY:
  # it records more ABOUT the same terminal; it changes no control flow, no
  # seed, no path condition and no dump field that existed before. The
  # shakedown's `concolic_terminal` carried type/cause/message and NOTHING
  # about WHERE the exception came from, so "where did this endpoint stop"
  # was unanswerable from the artifacts. These keys are added alongside.
  APP_ROOT     = "/home/dev/project/ruby_examples/dse-apps/apps/diaspora"
  AUTOLAB_ROOT = "/home/dev/project/reports/autolab"

  def frame_bucket(f)
    return "app"     if f.start_with?(APP_ROOT)
    return "autolab" if f.start_with?(AUTOLAB_ROOT)
    return "runtime" if f.start_with?(RUNTIME)
    return "gem"     if f.include?("/.gem/") || f.include?("/gems/")
    return "jruby"   if f.start_with?("/home/dev/tools/jruby")
    "other"
  end

  def terminal_record(e)
    bt = begin
      Array(e.backtrace)
    rescue StandardError
      []
    end
    rec = {
      "type" => e.class.name,
      "cause" => (e.cause && e.cause.class.name),
      "message" => e.message.to_s[0, 160],
      # FULL message too: the 160-char truncation above hid receiver spellings.
      "message_full" => e.message.to_s[0, 2000],
      "ancestry" => e.class.ancestors.take(6).map(&:to_s),
      "raising_frame" => bt[0],
      "backtrace" => bt.take(40),
      "backtrace_total" => bt.size,
      "frame_buckets" => bt.take(40).map { |f| frame_bucket(f) },
      "first_app_frame" => bt.find { |f| frame_bucket(f) == "app" },
      "first_autolab_frame" => bt.find { |f| frame_bucket(f) == "autolab" }
    }
    # NameError/NoMethodError carry the receiver and the missing name in
    # Ruby >= 2.3; guarded because a raiser may construct one without them.
    if e.is_a?(NameError)
      rec["missing_name"] = (begin
        e.name.to_s
      rescue StandardError
        nil
      end)
      rec["receiver_class"] = (begin
        e.receiver.class.name
      rescue StandardError, NotImplementedError
        nil
      end)
      rec["receiver_inspect"] = (begin
        e.receiver.inspect.to_s[0, 200]
      rescue StandardError, NotImplementedError
        nil
      end)
    end
    if e.respond_to?(:param)
      rec["param"] = (begin
        e.param.to_s
      rescue StandardError
        nil
      end)
    end
    rec
  rescue StandardError => bug
    { "type" => e.class.name, "message" => e.message.to_s[0, 160],
      "terminal_record_error" => "#{bug.class}: #{bug.message}" }
  end

  def run_one(cfg, label, seeds, terminal_box)
    ConcolicTargets.seed_overrides = seeds
    terminal_box[:value] = nil
    terminal_box[:handled] = nil   # e2e FIX-13: per-run, like :value
    clear_per_run_memos!

    klass = Object.const_get(cfg[:controller_class])
    ctrl, = make_harness(klass)

    if cfg[:signed_in]
      # PRINCIPAL MUST BE SYMBOLIC. LAZY/memoized so the resolution's queries
      # fire INSIDE $interceptor.run (at the action's first current_user
      # call), not before it.
      ctrl.singleton_class.define_method(:current_user) do
        ci_uid = symint("SYM_USER_CI_id", ConcolicTargets.seed_for("SYM_USER_CI_id", 1))
        @ci_user ||= User.serialize_from_session(ci_uid, "concolicsalt")
      end
      ctrl.singleton_class.define_method(:user_signed_in?) { true }
      # devise's authenticate_user! -> warden, which the controller-test rig
      # has no middleware for. A guard, not concolic logic.
      ctrl.singleton_class.define_method(:authenticate_user!) { :authenticate_user_called }
    else
      ctrl.singleton_class.define_method(:current_user) { nil }
      ctrl.singleton_class.define_method(:user_signed_in?) { false }
      # E2E FIX-6. The signed-in branch above already stubs
      # `authenticate_user!` because "devise's authenticate_user! -> warden,
      # which the controller-test rig has no middleware for". The ANONYMOUS
      # branch did not, and the app reaches it anyway -- from a `rescue_from`
      # handler (comments_controller.rb:16, likes_controller.rb:15) and from
      # Devise's own sessions controller. What got recorded was
      # `Devise::MissingWarden`, a RIG artifact, in the place where the
      # endpoint's outcome belongs. MEASURED on sessions_create,
      # sessions_destroy, comments_index and likes_index.
      #
      # The real app THROWS :warden here and its middleware turns that into a
      # redirect to sign-in. The rig has no middleware, so the honest thing
      # is a NAMED outcome saying exactly that, which is what this raises.
      ctrl.singleton_class.define_method(:authenticate_user!) do
        raise AutolabDSE::AuthenticationRequired,
              "authenticate_user! was called on an ANONYMOUS request " \
              "(directly or from a rescue_from handler); the real app " \
              "throws :warden here and its middleware redirects to sign-in"
      end
    end

    # e2e FIX-6, second half. `authenticate_user!` is not the only way into
    # Warden: `Devise::SessionsController#create` calls
    # `warden.authenticate!` DIRECTLY, and devise's accessor
    # (devise-4.7.1/lib/devise/controllers/helpers.rb:142-144) is
    # `request.env['warden'] or raise MissingWarden`. The rig dispatches the
    # action directly and has no Warden middleware, so `request.env` never
    # carries one. MEASURED: `sessions_create` and `sessions_destroy` both
    # recorded `Devise::MissingWarden` as their ENDPOINT OUTCOME, which reads
    # like an application fault and is not one -- it is the rig saying it
    # cannot model this endpoint at all, because this endpoint IS Warden
    # authentication.
    #
    # Stubbed in BOTH scenarios, because the accessor is reached from both.
    ctrl.singleton_class.define_method(:warden) do
      raise AutolabDSE::AuthenticationRequired,
            "the action asked for the Warden proxy " \
            "(devise/controllers/helpers.rb:142). The rig dispatches the " \
            "action directly and installs no Warden middleware, so there is " \
            "none. This endpoint cannot be driven without one."
    end

    begin
      ctrl.request.format = cfg[:format]
    rescue StandardError => e
      warn "[warn] could not set request format: #{e.class}"
    end
    ctrl.send(:action_name=, cfg[:action].to_s)

    body = lambda do
      # THE SYMBOLIC ENTRYPOINT ARGUMENTS. Declared INSIDE the `run` block:
      # CallInterceptor#run calls SymbolicFunc.reset! at its very start, which
      # clears @registered_vars — a symstr made before `run` would never
      # appear in the dump's symbolic_vars and Z3 would drop every PC over it.
      params = {}
      (cfg[:params] || {}).each do |key, spec|
        params[key] = symstr(spec[:sym], ConcolicTargets.seed_for(spec[:sym], spec[:default]))
      end
      ctrl.params = params.with_indifferent_access

      begin
        # Direct dispatch skips process_action, so the before_action callbacks
        # that READ DATA are replayed by hand. On a signed-in request
        # set_locale reads current_user.language and set_grammatical_gender
        # reads current_user.gender -> person -> profile.
        I18n.locale = "en" # deterministic per run (I18n.locale is global state)
        Array(cfg[:replay_callbacks]).each { |cb| ctrl.send(cb) }
        # An implicit-render action has NO method to send: HelpController is
        # an empty class body and `GET /help` renders app/views/help/faq.*
        # through Rails' default render. Direct dispatch skips the machinery
        # that would do that, so call default_render explicitly rather than
        # raising NoMethodError and booking it as an app outcome.
        if klass.method_defined?(cfg[:action]) || klass.private_method_defined?(cfg[:action])
          ctrl.send(cfg[:action])
        else
          ctrl.send(:default_render)
        end
      rescue Exception => e # rubocop:disable Lint/RescueException
        # E2E FIX-5. `rescue_with_handler` returns the EXCEPTION when a
        # handler ran (activesupport-5.2.4.3 rescuable.rb:88-100) and nil
        # when none matched -- but the old code also collapsed a handler that
        # ITSELF RAISED into the same nil, so the recorded terminal named the
        # ORIGINAL exception with no trace of the failure that actually
        # stopped the run. MEASURED: `comments_index` and `likes_index` each
        # recorded `Diaspora::NonPublic` as their outcome, while what really
        # happened is that the matching handler
        # (app/controllers/comments_controller.rb:16 `rescue_from
        # Diaspora::NonPublic { authenticate_user! }`) raised inside itself.
        # The three cases are now told apart and all three are recorded.
        handler_error = nil
        handled = begin
          ctrl.send(:rescue_with_handler, e)
        rescue Exception => he # rubocop:disable Lint/RescueException
          handler_error = he
          nil
        end
        if handled
          # e2e FIX-13: record the handled exception too. Without it a
          # rendered error page is indistinguishable from the action
          # completing — see this script's header for the measurement.
          rec = terminal_record(e)
          rec["handler"] = { "status" => "rescue_from handler HANDLED it",
                             "controller" => ctrl.class.to_s }
          (terminal_box[:handled] ||= []) << rec
        end
        unless handled
          # SCAFFOLD POLICY, not a curated one. The reference batches each
          # carry a hand-written `app_error_terminal?` predicate naming the
          # unrescued 500s that are REAL app outcomes for that action. A
          # generated runner has no such list, so it records every unrescued
          # exception as a terminal outcome and FLAGS the summary
          # (`terminal_policy: "generic"`). Curating this predicate is part of
          # promoting an endpoint from scaffolded to driven.
          terminal_box[:value] = terminal_record(e)
          terminal_box[:value]["handler"] =
            if handler_error
              { "status" => "rescue_from handler RAISED",
                "handler_exception" => terminal_record(handler_error) }
            else
              { "status" => "no rescue_from handler matched " \
                             "#{e.class} on #{ctrl.class}" }
            end
          next :app_error_500
        end
        handled
      end
      :ok
    end

    dump = $interceptor.run(body, {}, label: label, script: "run_dse.rb")
    dump["concolic_seeds"] = seeds
    dump["concolic_scenario"] = {
      "name" => cfg[:variant], "format" => cfg[:format].to_s,
      "signed_in" => !!cfg[:signed_in]
    }
    dump["concolic_terminal"] = terminal_box[:value] if terminal_box[:value]
    # e2e FIX-13. A SEPARATE key: `concolic_terminal` keeps meaning "the run
    # ended at an exception nothing rescued", and this one means "the
    # application raised and chose a handler". Both are outcomes; only the
    # first one stops the run.
    dump["concolic_handled"] = terminal_box[:handled] if terminal_box[:handled]

    # RUNNER-LOCAL LEAK WORKAROUND (reported, not patched in src_new/):
    # CallInterceptor keeps an unbounded @all_calls history ACROSS runs
    # (`run` only slices @all_calls[old_count..]). `run` recomputes old_count
    # at entry, so clearing the array between runs is safe.
    $interceptor.instance_variable_set(:@all_calls, [])

    dump
  end

  # -----------------------------------------------------------------------
  # prefix-directed exploration
  # -----------------------------------------------------------------------

  def explore(cfg)
    cfg = {
      format: :json, signed_in: false, params: {},
      replay_callbacks: (cfg[:signed_in] ? %i[set_locale set_grammatical_gender] : []),
      variant: nil
    }.merge(cfg)
    cfg[:variant] ||= "#{cfg[:signed_in] ? 'auth' : 'anon'}_#{cfg[:format]}"

    entry       = cfg[:entry]
    out         = ENV["DUMP_OUT"] || cfg[:out] || Dir.pwd
    max_runs    = (ENV["MAX_RUNS"] || cfg[:max_runs] || 6).to_i
    time_budget = (ENV["TIME_BUDGET"] || cfg[:time_budget] || 600).to_i
    FileUtils.mkdir_p(out)

    puts "== #{entry} :: prefix-directed DSE " \
         "(MAX_RUNS=#{max_runs}, TIME_BUDGET=#{time_budget}s, targets=#{targets_tier}) =="
    started = Time.now

    stack = [{}]
    if ENV["EXTRA_SEEDS_JSON"] && File.exist?(ENV["EXTRA_SEEDS_JSON"])
      extra = JSON.parse(File.read(ENV["EXTRA_SEEDS_JSON"]))
      extra = [extra] if extra.is_a?(Hash)
      stack = ENV["SEEDS_ONLY"] ? extra : (extra + stack)
    end

    seen_seeds   = Set.new
    seen_paths   = Set.new
    unflippable  = Hash.new(0)
    errors       = Hash.new(0)
    terminals    = Hash.new(0)
    terminal_rows = []
    runs         = 0
    written      = 0
    terminal_box = { value: nil }

    until stack.empty?
      if runs >= max_runs
        puts "[stop] MAX_RUNS reached"
        break
      end
      if Time.now - started > time_budget
        puts "[stop] time budget exhausted"
        break
      end

      seeds = stack.shift # FIFO: single flips of the root first, then pairs, …
      key = digest(JSON.generate(seeds.sort.to_h))
      next if !ENV["SEEDS_ONLY"] && seen_seeds.include?(key)
      seen_seeds << key

      runs += 1
      label = format("%s_dse%04d%s", cfg[:variant], runs, ENV["LABEL_SUFFIX"].to_s)

      begin
        dump = run_one(cfg, label, seeds, terminal_box)
      rescue Exception => e # rubocop:disable Lint/RescueException
        puts "[#{label}] HARNESS FAILURE #{e.class}: #{e.message.to_s[0, 300]}"
        puts e.backtrace.take(25).join("\n") if ENV["TRACE"]
        errors["harness:#{e.class}"] += 1
        next
      end

      errors["run:#{dump['error']['type']}"] += 1 if dump["error"]
      terminals[dump["concolic_terminal"]["type"]] += 1 if dump["concolic_terminal"]
      # E2E INVENTORY ADDITION: one row per EXECUTED run, before the
      # duplicate-path filter below discards the dump. Without this, the
      # terminal of any run whose path signature repeated was unrecoverable.
      terminal_rows << {
        "label" => label, "run_index" => runs,
        "seeds" => seeds,
        "path_conditions" => path_conditions(dump).size,
        "dump_written" => nil, # filled in below once the filter has decided
        "terminal" => dump["concolic_terminal"],
        "handled" => dump["concolic_handled"],
        "run_error" => dump["error"]
      }

      pcs = path_conditions(dump)
      sig = digest(sig_of(pcs))
      next if !ENV["SEEDS_ONLY"] && seen_paths.include?(sig)

      seen_paths << sig
      written += 1
      terminal_rows.last["dump_written"] = "dump_#{label}.json" if terminal_rows.last
      File.write(File.join(out, "dump_#{label}.json"), JSON.pretty_generate(dump))

      puts format("[%s] paths=%d runs=%d pcs=%d stack=%d %s",
                  label, written, runs, pcs.size, stack.size,
                  dump["error"] ? "error=#{dump['error']['type']}" : "")

      vals = {}
      (dump["symbolic_vars"] || []).each { |sv| vals[sv["name"].to_s] = sv["value"] }
      pcs.each do |(expr, taken)|
        fl = flip_any(expr, !taken, vals)
        if fl.nil?
          unflippable[expr] += 1
          next
        end
        child = seeds.merge(fl)
        ckey = digest(JSON.generate(child.sort.to_h))
        next if ENV["SEEDS_ONLY"]
        stack.push(child) unless seen_seeds.include?(ckey)
      end
    end

    elapsed = Time.now - started

    summary = {
      "entrypoint"         => entry,
      "strategy"           => "prefix-directed DSE (seed inheritance + single-branch flip)",
      "driver"             => "reports/autolab/entrypoints/lib/autolab_dse.rb",
      "targets_tier"       => targets_tier,
      "terminal_policy"    => "generic (uncurated: every unrescued exception is recorded " \
                              "as an outcome; see autolab_dse.rb)",
      "signed_in"          => !!cfg[:signed_in],
      "variant"            => cfg[:variant],
      "format"             => cfg[:format].to_s,
      "action"             => cfg[:action].to_s,
      "controller"         => cfg[:controller_class],
      "params"             => (cfg[:params] || {}).map { |k, v|
        [k.to_s, { "symbolic_name" => v[:sym], "seed" => v[:default] }]
      }.to_h,
      "runs_executed"      => runs,
      "distinct_paths"     => written,
      "seed_sets_tried"    => seen_seeds.size,
      "stack_remaining"    => stack.size,
      "worklist_exhausted" => stack.empty?,
      "max_runs"           => max_runs,
      "time_budget"        => time_budget,
      "elapsed_seconds"    => elapsed.round(1),
      "run_errors"         => errors,
      "terminals"          => terminals,
      "unflippable_pcs"    => unflippable,
      # E2E INVENTORY ADDITION (see terminal_record): the per-run stopping
      # evidence, with backtraces. `terminals` above stays exactly as it was.
      "terminal_rows"      => terminal_rows
    }
    File.write(File.join(out, "exploration_summary.json"), JSON.pretty_generate(summary))

    puts "\n== #{entry} exploration done =="
    puts "  runs executed  : #{runs}"
    puts "  distinct paths : #{written}"
    puts "  worklist empty : #{stack.empty?}"
    puts "  elapsed        : #{elapsed.round(1)}s"
    puts "  run errors     : #{errors.inspect}"
    puts "  terminals      : #{terminals.inspect}"
    puts "  unflippable    : #{unflippable.keys.size} distinct PC shapes"
    summary
  end
end
