#!/usr/bin/env python3
"""scaffold.py — emit per-endpoint scaffolding from manifest.json.

For every drivable endpoint the manifest lists, write

    entrypoints/scaffold/<id>/
        run_dse.rb   — a thin runner: CFG only, algorithm from ../../lib/autolab_dse.rb
        config.json  — a one-stack DESIGN_ONE_STACK §4 config, which is what
                       sweep's EndpointSpec.config points at
        launch.sh    — the exact scripts/diaspora-concolic invocation

Nothing batch-local is copied. Mocks and target declarations come from the
shared library at reports/autolab/targets/ via its registry.json, which the
driver loads at boot.

WHAT THIS IS NOT: these runners are GENERATED, not verified. Each one is a
plausible starting point built from measured route/controller facts; an
endpoint is only "driven" once it has produced dumps and a curated
`app_error_terminal?` policy.

Usage:
  /home/dev/project/venvs/queries_from_runs/bin/python3 scaffold.py
"""

from __future__ import annotations

import json
import re
import stat
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ENTRYPOINTS = HERE.parent
AUTOLAB = ENTRYPOINTS.parent
PROJECT = AUTOLAB.parent.parent
MANIFEST = ENTRYPOINTS / "manifest.json"
SCAFFOLD = ENTRYPOINTS / "scaffold"
LIB = ENTRYPOINTS / "lib" / "autolab_dse.rb"
LAUNCHER = PROJECT / "scripts" / "diaspora-concolic"

# Seeds that make run 1 reproduce plausible concrete behaviour. Distinct
# values per id-ish param so a cross-param equality is not accidentally true
# in the seed run (which would hide a branch).
NAMED_SEEDS = {
    "page": "1",
    "per_page": "15",
    "username": "alice",
    "name": "alice",
    "handle": "alice@localhost",
    "guid": "0123456789abcdef",
    "token": "tok",
    "type": "all",
    "show": "all",
    "provider": "twitter",
    "version": "2.0",
    "topic": "faq",
    "format": "json",
    "q": "alice",
    "key": "k",
}
ID_SEEDS = ["5", "7", "11", "13", "17", "19", "23", "29"]


def seed_for(param: str, idx: int) -> str:
    if param in NAMED_SEEDS:
        return NAMED_SEEDS[param]
    if param == "id" or param.endswith("_id"):
        return ID_SEEDS[idx % len(ID_SEEDS)]
    return "concolic"


RUNNER_TEMPLATE = '''#!/usr/bin/env jruby
# frozen_string_literal: true
#
# run_dse.rb — {entry}
#
#   {entrypoint}
#   {routes_comment}
#
# GENERATED by reports/autolab/entrypoints/tools/scaffold.py from
# entrypoints/manifest.json. This file is SCAFFOLDING: it has not been run.
# Regenerate it rather than hand-editing, or promote it out of scaffold/ once
# you start curating it.
#
# Everything generic (harness, symbolic principal, PC term rendering, the four
# flip matchers, the prefix-directed worklist) lives in the shared driver.
# Everything endpoint-specific about MOCKS lives in the shared target library
# at reports/autolab/targets/, loaded through its registry.json.
#
# Launch:
#   /home/dev/project/scripts/diaspora-concolic \\
#     {self_path}
#
# Env: MAX_RUNS, TIME_BUDGET, DUMP_OUT, EXTRA_SEEDS_JSON, SEEDS_ONLY,
#      LABEL_SUFFIX, TRACE — all read by the shared driver.
#
# MEASURED FACTS behind this CFG (from manifest.json):
{facts_comment}

require "/home/dev/project/reports/autolab/entrypoints/lib/autolab_dse"

AutolabDSE.boot!({entry!r})

AutolabDSE.explore(
  entry:            {entry!r},
  controller_class: {controller_class!r},
  action:           :{action},
  format:           :{fmt},
  signed_in:        {signed_in},
  out:              File.dirname(File.expand_path(__FILE__)),
  params:           {
{params_block}
  }
)
'''


def rb(s: str) -> str:
    """Ruby string literal."""
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main() -> int:
    if not MANIFEST.exists():
        sys.exit(f"missing {MANIFEST} — run build_manifest.py first")
    manifest = json.loads(MANIFEST.read_text())
    SCAFFOLD.mkdir(exist_ok=True)

    written = 0
    skipped = []
    index = []

    for e in manifest["endpoints"]:
        eid = e["id"]
        if e["status"] == "action_missing":
            skipped.append((eid, "dead route — no action method and no template"))
            continue

        d = SCAFFOLD / eid
        d.mkdir(exist_ok=True)

        # ---- symbolic inputs ---------------------------------------------
        # The PRIMARY route's path params, plus whatever else the action
        # reads out of params. Deliberately NOT the union over all routes:
        # people#show is reachable as /people/:id and as /u/:username, and no
        # single request carries both, so making both symbolic would invent
        # paths the app can never take. Alternate routes are recorded in
        # config.json .autolab.routes for whoever wants the other variant.
        primary = next(r for r in e["routes"] if r["primary"])
        names = list(
            dict.fromkeys(primary["path_params"] + e["params"]["read_in_action"])
        )
        params = {}
        for i, p in enumerate(names):
            params[p] = {"sym": f"SYM_PARAM_{p}", "default": seed_for(p, i)}

        signed_in = e["auth"]["recommended_scenario"] in ("auth", "both")
        fmt = "json" if "json" in (e["params"]["respond_to"] or []) or e["behaviour"]["renders_json"] else "html"

        # ---- run_dse.rb ---------------------------------------------------
        params_block = "\n".join(
            f"    {p}: {{ sym: {rb(spec['sym'])}, default: {rb(spec['default'])} }},"
            for p, spec in params.items()
        ).rstrip(",")
        if not params_block:
            params_block = "    # this action reads no route or request params"

        routes_comment = "; ".join(
            f"{r['verb']} {r['path']}" for r in e["routes"]
        )
        facts = [
            f"#   auth        : authenticate_user! enforced={e['auth']['authenticate_user_enforced']}, "
            f"reads current_user={e['auth']['reads_current_user']} "
            f"-> scenario '{e['auth']['recommended_scenario']}'",
            f"#   source      : {e['source']['file']}:{e['source']['line']} ({e['source']['loc']} loc)",
            f"#   filters     : {len(e['filters']['applied'])} applied"
            + (
                f", beyond ApplicationController: {', '.join(e['filters']['beyond_application_controller'])}"
                if e["filters"]["beyond_application_controller"]
                else ""
            ),
            f"#   models named: {', '.join(e['model_graph']['models_named']) or '(none)'} "
            f"({e['model_graph']['association_total']} associations)",
            f"#   cost / tier : {e['cost']['score']} / tier {e['priority']['tier']}"
            + (f"  blockers: {', '.join(e['cost']['blockers'])}" if e["cost"]["blockers"] else ""),
            f"#   targets     : tier={e['targets']['tier']}"
            + (f", override={e['targets']['override_file']}" if e["targets"]["override_file"] else ", core only"),
        ]
        if e["status"] == "implicit_render":
            facts.append(
                "#   NOTE        : no action method; Rails renders the template implicitly."
            )

        runner = (
            RUNNER_TEMPLATE.replace("{entry!r}", rb(eid))
            .replace("{controller_class!r}", rb(e["controller_class"] or ""))
            .replace("{entry}", eid)
            .replace("{entrypoint}", e["entrypoint"])
            .replace("{routes_comment}", routes_comment)
            .replace("{self_path}", str(d / "run_dse.rb"))
            .replace("{facts_comment}", "\n".join(facts))
            .replace("{action}", e["action"])
            .replace("{fmt}", fmt)
            .replace("{signed_in}", "true" if signed_in else "false")
            .replace("{params_block}", params_block)
        )
        (d / "run_dse.rb").write_text(runner)

        # ---- config.json (one-stack DESIGN_ONE_STACK §4) -------------------
        cfg = {
            "schema_version": 1,
            "endpoint": eid,
            "entrypoint": e["entrypoint"],
            "paths": {
                "root": str(d),
                "batch_dir": str(d),
                "out": str(d / "out"),
            },
            "runtime": {
                "adapter": "jruby",
                "targets": str(AUTOLAB / "targets" / "registry.json"),
                "shims": str(AUTOLAB / "targets" / "shared_shims.rb"),
                "runner": str(d / "run_dse.rb"),
            },
            "scenarios": {
                ("auth_" + fmt) if signed_in else ("anon_" + fmt): {
                    "MAX_RUNS": "6",
                    "TIME_BUDGET": "600",
                }
            },
            "fixtures": None,
            "real_mode_plan": None,
            "inputs": [
                {
                    "name": p,
                    "type": "string",
                    "symbolic_name": spec["sym"],
                    "seed": spec["default"],
                }
                for p, spec in params.items()
            ]
            + (
                [
                    {
                        "name": "principal",
                        "type": "int",
                        "symbolic_name": "SYM_USER_CI_id",
                        "seed": 1,
                    }
                ]
                if signed_in
                else []
            ),
            "must_stay_symbolic": sorted(
                [spec["sym"] for spec in params.values()]
                + (["SYM_USER_CI_id"] if signed_in else [])
            ),
            "request_format": fmt,
            "signed_in": signed_in,
            "limits": {
                "max_runs": 6,
                "max_probe_replays": 200,
                "max_solver_queries": 20000,
                "max_cliques": 200,
                "max_missing_per_clique": 50,
                "solver_rlimit": 4000000,
            },
            # Namespaced so nothing here can collide with a §4 key.
            "autolab": {
                "generated_by": "reports/autolab/entrypoints/tools/scaffold.py",
                "verified": False,
                "note": (
                    "Scaffolding. This endpoint has not been launched; the "
                    "runner is generated from measured route and controller "
                    "facts and has no curated app-error terminal policy."
                ),
                "priority_tier": e["priority"]["tier"],
                "cost_score": e["cost"]["score"],
                "blockers": e["cost"]["blockers"],
                "targets_tier": e["targets"]["tier"],
                "routes": [
                    {"verb": r["verb"], "path": r["path"], "primary": r["primary"]}
                    for r in e["routes"]
                ],
                "driven_before": e["driven_before"],
                "authoritative_batch": (
                    f"reports/diaspora/results4/{eid}" if e["driven_before"] else None
                ),
            },
        }
        (d / "config.json").write_text(json.dumps(cfg, indent=2) + "\n")

        # ---- launch.sh ----------------------------------------------------
        launch = f"""#!/usr/bin/env bash
# {eid} — {e['entrypoint']}
# GENERATED by scaffold.py. Not verified; see config.json .autolab.verified.
set -euo pipefail
exec {LAUNCHER} \\
  {d / 'run_dse.rb'} "$@"
"""
        lp = d / "launch.sh"
        lp.write_text(launch)
        lp.chmod(lp.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

        index.append(
            {
                "id": eid,
                "tier": e["priority"]["tier"],
                "rank": e["priority"]["rank"],
                "cost": e["cost"]["score"],
                "scenario": e["auth"]["recommended_scenario"],
                "targets_tier": e["targets"]["tier"],
                "dir": str(d.relative_to(AUTOLAB)),
            }
        )
        written += 1

    (SCAFFOLD / "_index.json").write_text(json.dumps(index, indent=2) + "\n")

    print(f"scaffolded {written} endpoints into {SCAFFOLD}")
    for eid, why in skipped:
        print(f"  skipped {eid}: {why}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
