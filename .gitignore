# Data files: every type that can grow past a few MB, plus suffixed copies
# of them (.stale, .pre_*, .p12, .dropped.json, ...). Regenerated by each
# endpoint's runner; REPORT.md carries the numbers.
*.json
*.json.*
*.jsonl
*.jsonl.*
*.pkl
*.pkl.*
*.txt
*.txt.*
*.log
*.out
*.err

